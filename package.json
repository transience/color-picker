{
  "name": "@transience/color-picker",
  "version": "0.6.0",
  "description": "A modern color picker component with support for OKLCH color space.",
  "author": "Gil Barbara <gilbarbara@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transience/color-picker.git"
  },
  "bugs": {
    "url": "https://github.com/transience/color-picker/issues"
  },
  "homepage": "https://transience.github.io/color-picker/",
  "keywords": [
    "color-picker",
    "color",
    "picker",
    "react",
    "oklch"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "peerDependencies": {
    "react": "16.8 - 19",
    "react-dom": "16.8 - 19",
    "tailwindcss": "3.4 - 4"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "colorizr": "^5.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@gilbarbara/eslint-config": "^2.0.3",
    "@gilbarbara/prettier-config": "^1.0.0",
    "@gilbarbara/tsconfig": "^1.0.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "addon-storybook-sync": "0.1.0",
    "del-cli": "^8.0.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jest-extended": "^7.0.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "repo-tools": "^0.3.1",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "pnpm clean && tsup",
    "watch": "tsup --watch",
    "clean": "del dist/*",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint --fix .",
    "typecheck": "tsc && tsc -p tests/tsconfig.json && tsc -p stories/tsconfig.json",
    "typevalidation": "attw -P",
    "format": "prettier --write --log-level=warn \"**/*.{yml,json,md,css}\"",
    "size": "size-limit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage",
    "validate": "pnpm check && pnpm build && pnpm size && pnpm format && pnpm typevalidation",
    "prepare": "husky"
  },
  "tsup": {
    "bundle": true,
    "dts": {
      "compilerOptions": {
        "ignoreDeprecations": "6.0"
      }
    },
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "cjs",
      "esm"
    ],
    "loader": {
      ".gif": "dataurl"
    },
    "sourcemap": true,
    "splitting": false
  },
  "prettier": "@gilbarbara/prettier-config",
  "size-limit": [
    {
      "name": "commonjs",
      "path": "./dist/index.cjs",
      "limit": "35 kB"
    },
    {
      "name": "esm",
      "path": "./dist/index.js",
      "limit": "30 kB"
    }
  ],
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
